{
  "name": "@nialto-services/astro-reviews",
  "version": "0.1.3",
  "description": "Sync a business's Trustindex reviews into an Astro site, so they render as static content with no third-party script.",
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@10.30.2",
  "engines": {
    "node": ">=22.12"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/NialtoServices/astro-reviews.git"
  },
  "bin": {
    "astro-reviews": "bin/astro-reviews.mjs"
  },
  "exports": {
    ".": {
      "types": "./src/index.d.ts",
      "default": "./src/index.mjs"
    }
  },
  "files": [
    "bin",
    "src",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "test": "vitest run",
    "prepublishOnly": "pnpm format:check && pnpm test",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "peerDependencies": {
    "astro": "^7.4.0"
  },
  "devDependencies": {
    "@ianvs/prettier-plugin-sort-imports": "^4.7.1",
    "astro": "^7.4.4",
    "prettier": "^3.9.9",
    "vitest": "^5.0.2"
  }
}
